--[[
#=====================================================================================
#                               aureola (Edición Colores Unificados 2026)
# Date    : 08/10/2026
# Author  : Erik Dubois & AI Customizer
# Target  : Intel Core i7-10710U (Gráficas y Barras en Sintonía Estética)
#======================================================================================
]]

conky.config = {

	-- Parámetros del motor y rendimiento
	background = true, 							-- Lanza Conky en segundo plano al arrancar
	cpu_avg_samples = 2,						-- Muestras para promediar el uso de CPU
	diskio_avg_samples = 15,					-- Mayor muestreo para suavizar picos en NVMe
	double_buffer = true,						-- Activa el búfer doble para evitar el parpadeo
	if_up_strictness = 'address',				-- Comprobación estricta de interfaz de red activa
	net_avg_samples = 2,						-- Muestras para promediar la velocidad de red
	no_buffers = true,							-- Resta la caché del cálculo de memoria RAM usada
	temperature_unit = 'celsius',				-- Escala térmica global
	text_buffer_size = 2048,					-- Tamaño del búfer de texto asignado
	update_interval = 1,						-- Frecuencia de refresco en segundos

	-- Posicionamiento y dimensiones en el escritorio
	alignment = 'top_right',					-- Esquina superior derecha de la pantalla
	gap_x = 15,									-- Margen lateral derecho en píxeles
	gap_y = 40,									-- Margen superior en píxeles
	minimum_width = 280,						-- Ancho mínimo del panel lateral
	maximum_width = 280,						-- Ancho máximo para mantener simetría fija

	-- Parámetros gráficos por defecto
	border_inner_margin = 10, 					-- Margen interno entre texto y borde del widget
	border_outer_margin = 1, 					-- Margen externo entre el borde y el escritorio
	border_width = 0, 							-- Grosor del borde exterior
	default_bar_width = 280,					-- Ancho base para las barras de progreso
	default_bar_height = 8,                     -- Grosor estilizado de las barras
	default_gauge_height = 25,
	default_gauge_width =40,
	default_graph_height = 30,					-- Altura de los gráficos de CPU/Red
	default_graph_width = 135,					-- Ancho exacto de los gráficos (para 2 en paralelo)
	default_shade_color = '#000000',
	default_outline_color = '#000000',
	draw_borders = false,						-- Oculta marcos del contenedor
	draw_graph_borders = true,					-- Dibuja un marco sutil en los gráficos
	draw_shades = false,
	draw_outline = false,
	stippled_borders = 0,

	-- Parámetros de Fuentes
	extra_newline = false,
	format_human_readable = true,				-- Muestra unidades autoajustables (MB, GB, TB)
	font = 'Ubuntu:bold:size=10',				-- Fuerza negrilla real en el motor gráfico
	max_text_width = 0,
	max_user_text = 16384,
	override_utf8_locale = true,				-- Fuerza compatibilidad de tildes y caracteres
	short_units = true,							-- Abreviaciones de red breves (k, M, G)
	top_name_width = 16,                        -- Ajustado para dar más margen a los números
	top_name_verbose = false,
	uppercase = false,
	use_spacer = 'none',
	use_xft = true,								-- Habilita suavizado tipográfico TrueType
	xftalpha = 1,

	-- Configuración e integración con el Gestor de Ventanas (Cinnamon)
	own_window = true,
	own_window_argb_value = 0,                 	-- Transparencia total del fondo (Alfa = 0)
	own_window_argb_visual = true,
	own_window_class = 'Conky',
	own_window_colour = '#000000',
	own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager', -- Comportamiento de widget
	own_window_transparent = true,              -- Fondo translúcido activo
	own_window_title = 'system_conky',
	own_window_type = 'desktop',                -- Se ancla fijamente sobre el tapiz del fondo

	-- Paleta Cromática (Nord-Neon de alto brillo y visibilidad)
	default_color = '#FFFFFF',  				-- Blanco puro
	color1 = '#FFFFFF',                         -- Blanco puro brillante para etiquetas
	color2 = '#4C566A',                         -- Gris pizarra oscuro para rieles de barras (UNIFICADO)
	color3 = '#E5E9F0',                         -- Blanco ártico para temperaturas
	color4 = '#FF6C6C',                         -- Rojo neón vivo para alertas de procesos top
	color5 = '#00DFFF',                         -- Azul celeste eléctrico para títulos
	color6 = '#A6E22E',                         -- Verde lima fosforito para datos dinámicos y relleno
};


conky.text = [[
# SECCIÓN: INFORMACIÓN DE LA BASE DEL SISTEMA OPERATIVO
${font ConkySymbols:size=14}u${font} ${voffset -10} ${color}${font Comfortaa:bold:size=12}${execi 6000 lsb_release -s -d}${font}
${hr 2}
${font Ubuntu:bold:size=10}Base :${color6} $sysname $kernel
${voffset 0}${color1}Tiempo de actividad:${color6} $uptime${font}

# SECCIÓN: PROCESADOR (CPU) Y TEMPERATURA GRÁFICA (GPU)
${color5}${font ConkySymbols:size=16}f${font} ${voffset -10} ${voffset 5} ${font Ubuntu:bold:size=10}Procesamiento${font}  ${stippled_hr 3 3}
${font Ubuntu:bold:size=10}${color1}Freq: ${color6}${freq_g} GHz${goto 155}${color1}GPU : ${color3}${acpitemp}°C
${color1}CPU1 ${color6}${cpu cpu1}% ${color3}${cpu temp}°C${goto 155}${color1}CPU2  ${color6}${cpu cpu2}% ${color3}${cpu temp}°C
${color1}CPU3 ${color6}${cpu cpu3}% ${color3}${cpu temp}°C${goto 155}${color1}CPU4  ${color6}${cpu cpu4}% ${color3}${cpu temp}°C
${color1}CPU5 ${color6}${cpu cpu5}% ${color3}${cpu temp}°C${goto 155}${color1}CPU6  ${color6}${cpu cpu6}% ${color3}${cpu temp}°C${font}
# UNIFICADO: Barras horizontales cpubar ahora comparten el mismo color de riel y de relleno que las gráficas
${voffset 5}${color1}Grafico CPU1: ${color6}${cpubar cpu1 8,140}${color6}
${color1}Grafico CPU2: ${color6}${cpubar cpu2 8,140}${font}

# SECCIÓN: MEMORIA RAM
${color5}${font ConkySymbols:size=16}J${font} ${voffset -10} ${voffset 5} ${font Ubuntu:bold:size=10}Ram ${memmax}${font}  ${stippled_hr 3 3}
${font Ubuntu:bold:size=10}${color1}Usada: ${color6}$mem${color1}${alignr}Libre: ${color6}$memeasyfree${font}
${color6}${voffset 3}${membar}

# SECCIÓN: ALMACENAMIENTO (Etiquetas simplificadas a NVMe)
${color5}${font ConkySymbols:size=16}k${font} ${voffset -10} ${voffset 5}${color5}${font Ubuntu:bold:size=10}Almacenamiento${font}  ${stippled_hr 3 3}
${font Ubuntu:bold:size=10}${color1}NVMe (/): ${color6}${fs_used /} / ${fs_size /}${color1}${alignr 2}Usado: ${color6}${fs_used_perc /}%
${color6}${voffset 3}${fs_bar /}
# Condicional: Solo dibuja la barra si el segundo disco NVMe se encuentra montado
${if_mounted /media/kabuto/DATOS}\
${color1}NVMe (DATOS): ${color6}${fs_used /media/kabuto/DATOS} / ${fs_size /media/kabuto/DATOS}${color1}${alignr 6}Usado: ${color6}${fs_used_perc /media/kabuto/DATOS}%${font}
${color6}${voffset 3}${fs_bar /media/kabuto/DATOS}
${endif}\
# Velocidades de transferencia y gráfica global de entrada/salida de almacenamiento
${font Ubuntu:bold:size=10}${color1}Lectura: ${color6}${diskio_read}${goto 155}${color1}Escritura: ${color6}${diskio_write}${font}
${color6}${diskiograph 25,280 #2E3440 #A6E22E}

# SECCIÓN: CONECTIVIDAD E INTERNET (RED INALÁBRICA)
${color5}${font ConkySymbols:size=16}b${font} ${voffset -10}${voffset 5}${color5}${font Ubuntu:bold:size=10}Red Inalámbrica${font}  ${stippled_hr 3 3}
${font Ubuntu:bold:size=10}${color1}Conectado a: ${alignr}${color6}${execi 10 LANG=C nmcli -t -f active,ssid dev wifi | grep '^yes' | cut -d: -f2}
${color1}Señal: ${alignr}${color6}${execi 10 LANG=C nmcli -t -f active,signal dev wifi | grep '^yes' | cut -d: -f2}%
${color1}IP Local: ${alignr}${color6}${addr wlo1}
${color1}IP Pública: ${alignr}${color6}${execi 3600 wget -q -O - -4 https://icanhazip.com}
${color1}Conexiones activas: ${alignr}${color6}${tcp_portmon 1 65535 count}
${color1}Bajada: ${alignr}${color6}${downspeed wlo1}
${color1}Subida: ${alignr}${color6}${upspeed wlo1}${font} 
${color6}${downspeedgraph wlo1 20,135 #2E3440 #A6E22E -l} $alignr${upspeedgraph wlo1 20,135 #2E3440 #A6E22E -l}
${font Ubuntu:bold:size=10}${color1}Recibidos: ${alignr 5}Enviados:
${color1}Sesión:${color6}${goto 75}${totaldown wlo1} ${alignr 5}${totalup wlo1}
${color1}Hoy:${color6}${goto 75}${execi 60 vnstat -i wlo1 --oneline | cut -d';' -f4}${alignr 5}${execi 60 vnstat -i wlo1 --oneline | cut -d';' -f5}${font}

# SECCIÓN: PROCESOS EN EJECUCIÓN ORDENADOS POR CPU
${color5}${font ConkySymbols:size=16}n${font} ${voffset -10} ${voffset 5}${color5}${font Ubuntu:bold:size=10}Procesos${font}  ${stippled_hr 3 3}
${font Ubuntu:bold:size=10}${color1}Nombre${goto 155}CPU%${alignr}MEM%
${color4}${top name 1} ${goto 155}${top cpu 1}${alignr}${top mem 1}${color6}
${top name 2} ${goto 155}${top cpu 2}${alignr}${top mem 2}
${top name 3} ${goto 155}${top cpu 3}${alignr}${top mem 3}
${top name 4} ${goto 155}${top cpu 4}${alignr}${top mem 4}
${top name 5} ${goto 155}${top cpu 5}${alignr}${top mem 5}${font}

# SECCIÓN: PROCESOS EN EJECUCIÓN ORDENADOS POR MEMORIA RAM
${color5}${font ConkySymbols:size=16}M${font} ${voffset -10} ${voffset 5}${color5}${font Ubuntu:bold:size=10}Memoria${font}  ${stippled_hr 3 3}
${font Ubuntu:bold:size=10}${color1}Nombre${goto 155}MEM%${alignr}RAM REAL
${color4}${top_mem name 1} ${goto 155}${top mem 1}${alignr}${top mem_res 1}${color6}
${top_mem name 2} ${goto 155}${top mem 2}${alignr}${top mem_res 2}
${top_mem name 3} ${goto 155}${top mem 3}${alignr}${top mem_res 3}
${top_mem name 4} ${goto 155}${top mem 4}${alignr}${top mem_res 4}
${top_mem name 5} ${goto 155}${top mem 5}${alignr}${top mem_res 5}${font}
${voffset -35}
]]

